# ==============================================================================
# Configuration Serveur Backend ERGR Zaccar
# ==============================================================================
PORT=5000
NODE_ENV=production

# URL publique de l'application (Prévient le Host Header Poisoning)
APP_BASE_URL=https://ergr-zaccar.dz

# Origines autorisées CORS (séparées par une virgule)
ALLOWED_ORIGINS=https://ergr-zaccar.dz,https://www.ergr-zaccar.dz,http://localhost:5173

# Clé secrète pour les opérations d'administration (/api/alerts/broadcast, /api/alerts/stats)
# GÉNÉREZ UNE CLÉ FORTE (ex: via `openssl rand -hex 32`)
ADMIN_API_KEY=changez_cette_cle_secrete_longue_et_complexe_2026

# E-mail de réception des formulaires (Contact & Recrutement)
RECIPIENT_EMAIL=zaccar.informatique@gmail.com

# Configuration SMTP (Gmail ou serveur d'entreprise)
# Pour Gmail, activez la validation en 2 étapes sur votre compte Google,
# puis créez un "Mot de passe d'application" (16 caractères) dans la sécurité de votre compte Google.
# ATTENTION : Ne commitez JAMAIS votre mot de passe réel sur Git !
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Nom affiché pour les e-mails
APP_NAME=ERGR Zaccar
