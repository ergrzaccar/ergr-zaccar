# ==============================================================================
# Backend Dockerfile for ERGR Zaccar Node.js API
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev

# Copy server code and env template
COPY server/ ./server/
COPY .env.example ./.env.example

# Create inbox and upload directories and assign ownership to non-root node user
RUN mkdir -p server/inbox/uploads && \
    chown -R node:node /app

ENV PORT=5000
ENV NODE_ENV=production

# Security: Run as non-privileged node user (CWE-250)
USER node

EXPOSE 5000

CMD ["node", "server/index.mjs"]
