# ==============================================================================
# Backend Dockerfile for ERGR Zaccar Node.js API
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev

# Copy server code and env template
COPY server/ ./server/
COPY .env.example ./.env.example

# Create inbox and upload directories
RUN mkdir -p server/inbox/uploads

ENV PORT=5000
ENV NODE_ENV=production

EXPOSE 5000

CMD ["node", "server/index.mjs"]
